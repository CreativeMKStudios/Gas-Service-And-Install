---
import { business } from "../data/business";
---
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="cta">
      <div>
        <h2>Tell us what the boiler is doing</h2>
        <p>Call or text during opening hours. If you can, have the make of the boiler ready.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-gold" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
        <a class="btn btn-white" href="/contact">Get a quote</a>
      </div>
    </div>
  </div>
</section>
