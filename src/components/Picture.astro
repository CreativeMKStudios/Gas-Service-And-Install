---
import { photos, type PhotoKey } from "../data/business";

interface Props {
  name: PhotoKey;
  eager?: boolean;
  sizes?: string;
  position?: string;
}

const sources = {
  plant: {
    src: "/images/plant-room-1600.webp",
    srcset: "/images/plant-room-960.webp 960w, /images/plant-room-1600.webp 1600w",
    width: 1600,
    height: 1200,
  },
  combi: {
    src: "/images/ideal-combi-1200.webp",
    srcset: "/images/ideal-combi-720.webp 720w, /images/ideal-combi-1200.webp 1200w",
    width: 1200,
    height: 1600,
  },
  vanBrand: {
    src: "/images/van-brand.webp",
    srcset: "/images/van-brand.webp 720w",
    width: 720,
    height: 1280,
  },
  vanWash: {
    src: "/images/van-wash.webp",
    srcset: "/images/van-wash.webp 900w",
    width: 900,
    height: 1600,
  },
  badge: {
    src: "/images/gas-safe-badge.webp",
    srcset: "/images/gas-safe-badge.webp 960w",
    width: 960,
    height: 600,
  },
} as const;

const pic = sources[Astro.props.name];
const meta = photos[Astro.props.name];
---
<img
  src={pic.src}
  srcset={pic.srcset}
  sizes={Astro.props.sizes ?? "(min-width: 900px) 50vw, 100vw"}
  width={pic.width}
  height={pic.height}
  alt={meta.alt}
  loading={Astro.props.eager ? "eager" : "lazy"}
  fetchpriority={Astro.props.eager ? "high" : "auto"}
  decoding="async"
  style={Astro.props.position ? `object-position: ${Astro.props.position}` : undefined}
/>
